{
  "manifest_version": 3,
  "name": "PromptCraft – AI Prompt Enhancer",
  "version": "1.0.0",
  "description": "Enhance any prompt using 6 proven prompt engineering techniques.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://api.groq.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
